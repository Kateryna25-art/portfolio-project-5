{
    "$schema": "https://schemas.wp.org/wp/6.4/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "90rem",
            "wideSize": "90rem"
        }
    },
    "styles": {
        "typography": {
            "fontSize": "1rem",
            "lineHeight": "1.75rem"
        },
        "spacing": {
            "blockGap": "1.5rem",
            "padding": {
                "top": "0rem",
                "right": "0rem",
                "bottom": "0rem",
                "left": "0rem"
            }
        }
    }
}
